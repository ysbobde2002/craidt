# Copy to .env (gitignored). Leave values empty here.
# Production reads the same names from Railway variables / GitHub Actions secrets.
# OPENAI_API_KEY is already a GitHub secret — do not put a real key in this file.

PORT=5180

# Stripe (ACP-demo style). Test keys only (sk_test_ / pk_test_).
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SELLER_SECRET_KEY=
STRIPE_SELLER_PUBLIC_KEY=
STRIPE_SELLER_ACCOUNT_ID=
STRIPE_TEST_PM=pm_card_visa
STRIPE_TEST_CUSTOMER_ID=

# Ethereum Sepolia — incentive + cashback + ERC-8004 identity
ETH_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
USDC_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
EXPLORER_BASE_URL=https://sepolia.etherscan.io
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
BUYER_WALLET_ADDRESS=0x8873cD8D93D6FDee9d21F699723C90eeC783747e
BUYER_WALLET_PRIVATE_KEY=
SELLER_PAYTO_ADDRESS=0x8873cD8D93D6FDee9d21F699723C90eeC783747e
SELLER_WALLET_PRIVATE_KEY=
AGENT_WALLET_ADDRESS=0x8873cD8D93D6FDee9d21F699723C90eeC783747e

# x402 / ERC-8004. Incentive USDC is paid to AGENT_WALLET_ADDRESS.
# Merchant signer is SELLER_WALLET_PRIVATE_KEY; it must hold the USDC.

# OpenAI — buyer intent capture. Required for the clarification chat.
# UCP search does not run until query + budget are known.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# x402 / ERC-8004 (optional)
X402_NETWORK=eip155:11155111
X402_FACILITATOR_URL=https://x402.org/facilitator
ERC8004_AGENT_ID=9638
ERC8004_CHAIN_ID=11155111
SCAN8004_API_BASE=https://testnet.8004scan.io/api/v1
SCAN8004_WEB_BASE=https://testnet.8004scan.io
SCAN8004_API_KEY=
DEMO_CATALOG_USD_PER_USDC=10000
DEMO_SERVER_SIGN=true
